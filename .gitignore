
# =========================================
# Core
# =========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/

# Environment / secrets
*.env
.secrets/
.token
*.key
*.pem

# OS files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDE
.vscode/
*.code-workspace
.idea/
*.sublime-project
*.sublime-workspace
.spyproject
.ropeproject

# =========================================
# Python packaging & distribution
# =========================================
# Build artifacts (DO NOT COMMIT)
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
*.whl

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Pyenv
.python-version


# =========================================
# Jupyter & docs
# =========================================
.ipynb_checkpoints/
# Sphinx
docs/_build/
# MkDocs
site/
# PDFs (e.g. technical documentations)
*.pdf

# =========================================
# Logs / runtime
# =========================================
logs/
*.log
*.pid
*.out

# Dask / Ray / joblib temp
dask-worker-space/
ray_results/
joblib/

# =========================================
# Cookiecutter Data Science structure
# see: https://drivendata.github.io/cookiecutter-data-science/
# =========================================
# Data (keep directories, not the large files)
data/**
models/**
results/**

# Keep placeholders so directories exist
!data/.gitkeep
!models/.gitkeep
!results/.gitkeep

# Reports (exported figures/assets)
reports/figures/**
!reports/figures/.gitkeep

# =======================================================
# Geospatial / large binaries (recommend Git LFS instead)
# =======================================================
*.tif
*.tiff
*.img
*.nc
*.hdf
*.h5
*.zip
*.7z
*.tar
*.tar.gz
*.parquet
*.gpkg
*.sqlite

# GDAL/OGR sidecars & overviews (regenerateable)
*.aux.xml
*.ovr
*.rrd
*.msk
*.cpg
*.qml

# =========================================
# Local tooling caches
# =========================================
.cache/
.ruff_cache/
pytestdebug.log

# Conda/Mamba environments
*.conda
*.mamba

# Jupyter Lab extensions (if using JupyterLab)
.jupyter/

# Python wheels in development
*.whl

# Sandbox notebook
notebooks/sandbox.ipynb

# Instructions for AI assistant
.claude
.codex

