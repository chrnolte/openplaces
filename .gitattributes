# Auto detect text files and normalize line endings to LF in the repository
* text=auto

# Files whose line endings should be normalized across operating systems
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# The admin spine is written byte-exact (UTF-8, no BOM, LF) by both of
# its writers, so a rebuild on any platform reproduces the committed file
src/openplaces/recipes/_all/admin/spine/**/*.csv text eol=lf

# Files that are binary and don't need auto-detection of text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.parquet binary
*.zip binary

# Strip outputs and execution logs from notebooks
*.ipynb filter=nbstripout diff=ipynb text eol=lf
*.zpln filter=nbstripout
