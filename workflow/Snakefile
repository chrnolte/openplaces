# Snakemake workflow for the openplaces pipeline.
#
# One job = one (stage, recipe, admin unit) node of the recipe DAG, the
# same granularity as the recipes themselves. RecipeDAG derives every
# job, its inputs/outputs, and its retention class from the recipe tree,
# so the recipes stay the single source of truth: adding an enrichment
# recipe to a curation pipeline automatically adds its jobs and its
# image-cache dependency.
#
# Retention maps onto Snakemake flags: until_consumed outputs are temp()
# (deleted only after every consuming job has finished — the
# reference-counted semantics of the lifecycle design, with zero
# openplaces bookkeeping), everything else is a plain output.
# Snakemake never writes tombstone receipts; run_stage sets
# OPENPLACES_ORCHESTRATED so receipt-based skips are voided and the
# physical files Snakemake expects are always produced.
#
# Nothing is protected(). Snakemake's protection is one-way: it strips
# write permission and then refuses to ever regenerate the file,
# aborting the run. Applied to the share bucket it meant re-curating an
# already-shipped county failed outright. The shipped bundle is guarded
# instead by io/delivery.py, which leaves its four files read-only.
# That refusal is a filesystem check, not a record of Snakemake's own
# flag, so the deliver rule clears the bit while planning (see below).
#
# The graph ends in a 'deliver' job when the target recipe declares a
# `share: delivery:` block and the run covers the region it names: every
# member county is pooled into the shareable bundle, so a full run ships
# without anyone remembering to. A narrower run gets no delivery job;
# --config deliver=true forces one, deliver=false suppresses it.
#
# An unscoped run seeds its admin units from the declared members, which
# means walking the recipe tree once per member: measured at ~7 minutes
# of graph construction for the 45-county CHEER region, before any job
# is dispatched. It is planning, not a hang.
#
# Run with --rerun-triggers mtime (set in the profile): recipe-YAML
# edits must not cascade re-runs (openplaces has no parameter hashing).
#
# Usage:
#   snakemake -n --config recipe=US_footprint-cheer-2026 \
#       admin_ids=US-NC-BS,US-NC-CE
#   snakemake -n --config recipe=US_footprint-cheer-2026   # region + ship
#   python -m openplaces.flow.submit --config recipe=... admin_ids=...

import csv
import re
from pathlib import Path

from openplaces.config import cfg
from openplaces.flow import RecipeDAG
from openplaces.flow.dag import rule_name

TARGET = config.get('recipe', 'US_footprint-cheer-2026')
ADMIN_IDS = config.get('admin_ids', [])
if isinstance(ADMIN_IDS, str):
    ADMIN_IDS = [a for a in ADMIN_IDS.split(',') if a]

# Recipe IDs to prune from the graph (and everything only reachable through
# them), e.g. opt-in enrichment lanes not requested for this run. Not a
# fixed constant -- read from the run's own config, so lowercase.
exclude_recipe_ids = config.get('exclude_recipe_ids', [])
if isinstance(exclude_recipe_ids, str):
    exclude_recipe_ids = [r for r in exclude_recipe_ids.split(',') if r]

# None lets the DAG decide from scope; true/false override it.
deliver = config.get('deliver')
if isinstance(deliver, str):
    deliver = deliver.strip().lower() in ('1', 'true', 'yes')

dag = RecipeDAG(
    TARGET,
    admin_ids=ADMIN_IDS,
    exclude_recipe_ids=set(exclude_recipe_ids) or None,
    deliver=deliver,
)


# Per-stage resources, with single-admin pins for known heavy units and
# attempt-scaled memory on retries (see workflow/profiles/scc/mem_lookup.csv)
def _load_mem_lookup():
    lookup = {}
    lookup_path = Path(workflow.basedir) / 'profiles' / 'scc' / 'mem_lookup.csv'
    if lookup_path.exists():
        with open(lookup_path, encoding='utf-8') as f:
            for row in csv.DictReader(f):
                if not row.get('stage') or str(row['stage']).startswith('#'):
                    continue
                key = (
                    row['stage'],
                    (row.get('recipe_id') or '').strip() or None,
                    (row.get('admin_id') or '').strip() or None,
                )
                lookup[key] = int(row['mem_mb'])
    return lookup


MEM_LOOKUP = _load_mem_lookup()

# One concurrency token per ingest recipe that stages files into a heap
# directory, so a recipe never runs two admin units against its own
# staging area at once.
#
# The collision is on the *directory*, not the archive name. A heap path
# is keyed by the recipe's own admin scope --
# `_heap/US/NC/_all/footprint/ncdps/2023/` -- so every county of a
# state-scoped recipe extracts into one place even when each county has
# its own zip. Classifying by archive filename missed that and let the
# race back in: 14 `PermissionError [WinError 32]`, eight pyogrio
# openfilegdb failures reading a GDB mid-write, and a `DataSourceError`
# on the ncdps heap, in a three-county run.
#
# Serializing all ingest behind a single token also fixed it, but cost
# every recipe's parallelism and projected to ~24 h for one region. A
# token per recipe keeps unrelated ingests concurrent.
def _heap_token(recipe_id: str) -> str:
    return 'heap_' + re.sub(r'[^0-9a-zA-Z]+', '_', recipe_id).strip('_').lower()


def _staging_recipes() -> dict:
    tokens = {}
    for node in dag.nodes():
        if node.stage != 'ingest':
            continue
        recipe = dag._recipe(node.recipe_id)
        if recipe.get('compressed_file_name') or recipe.get('uncompressed_file_name'):
            tokens[node.recipe_id] = _heap_token(node.recipe_id)
    return tokens


HEAP_TOKENS = _staging_recipes()

STAGE_RUNTIME_MIN = {
    'ingest': 720,
    'harmonize': 240,
    'enrich': 720,
    'curate': 240,
    'deliver': 60,
}



def mem_mb(stage, admin_id, recipe_id=None):
    """Memory reservation, most specific match first.

    Keyed on the recipe as well as the stage, because the heavy jobs are
    heavy by recipe: a global tile overlay and a one-county parcel ingest
    are both `ingest`, and giving them the same reservation lets the
    scheduler pack several of the former into one machine.
    """
    for key in (
        (stage, recipe_id, admin_id),
        (stage, recipe_id, None),
        (stage, None, admin_id),
        (stage, None, None),
    ):
        if key in MEM_LOOKUP:
            return MEM_LOOKUP[key]
    return 8000


rule all:
    input:
        [str(p) for p in dag.target_paths()]


for node in dag.nodes():
    _out = str(dag.output_path(node.stage, node.recipe_id, node.admin_id))
    _retention = dag.retention(node.stage, node.recipe_id, node.admin_id)
    # Deliberately NOT temp(). `until_consumed` is openplaces' own
    # retention class, cleaned up by `io.cleanup` which knows an output is
    # more than one file. Snakemake's temp() deletes only the primary
    # parquet and leaves the `_geo` sidecar and every link table behind,
    # so the unit ends up in a state neither side considers complete:
    # measured on `dwelling-overture-2025` for US-NC-CM, whose directory
    # kept _geo and both geospine link tables while the attribute file it
    # is declared to produce had been removed. One owner for the
    # lifecycle, and it is not the orchestrator.
    _flagged = _out
    if node.stage == 'deliver':
        # io/delivery.py leaves the shipped bundle read-only between runs,
        # and Snakemake refuses to run any rule whose output is read-only --
        # whatever set the bit. Clear it while planning; the delivery step
        # re-locks after writing. A dry run leaves the files unlocked until
        # the next delivery, which is the price of the guard.
        from openplaces.io.delivery import unlock_delivery

        # Name the region. A recipe declaring more than one refuses to
        # guess which bundle is meant (by design -- picking wrong ships a
        # region's rows under another's filename), so an unqualified call
        # here aborts planning for every multi-region recipe, which is
        # every CHEER build.
        unlock_delivery(
            node.recipe_id,
            region=dag.delivery_region(node.recipe_id, node.admin_id),
        )
    _job = (node.stage, node.recipe_id, node.admin_id)
    _extra = [str(p) for p in dag.extra_outputs(*_job)]
    _inputs = [str(p) for p in dag.input_paths(*_job)]
    # A deliver job is addressed by region, not by admin unit: that is
    # what run_stage forwards to export_delivery. Every other stage takes
    # the admin unit it processes.
    if node.stage == 'deliver':
        _stage_arg = dag.delivery_region(node.recipe_id, node.admin_id)
    else:
        _stage_arg = node.admin_id
    _admin_arg = f' {_stage_arg}' if _stage_arg else ''

    rule:
        name:
            rule_name(node)
        input:
            _inputs
        output:
            _flagged,
            *_extra,
        # Persistent per-job wall/CPU/RSS profile, one tsv per rule, in
        # the same _logs tree where openplaces' own stage timers land on
        # finish(). Together they give ex-post profiling at two grains:
        # Snakemake's job totals here, the library's per-step timings in
        # the JSON files beside them. notebooks/flow/monitor_build.ipynb
        # joins the two on (stage, recipe, admin unit).
        benchmark:
            str(
                Path(cfg.get_dir('cache'))
                / '_logs'
                / 'benchmarks'
                / f'{rule_name(node)}.tsv'
            )
        resources:
            mem_mb=lambda wc, attempt, _s=node.stage, _a=node.admin_id, _r=node.recipe_id: (
                mem_mb(_s, _a, _r) * attempt
            ),
            runtime=STAGE_RUNTIME_MIN.get(node.stage, 240),
            # One token per shared-heap recipe, not one for all ingest.
            #
            # Only a recipe whose unzipped source is a single directory
            # shared by many admin units can race: two counties then have
            # one job reading a GDB while another rewrites it (208 rule
            # failures in a 45-county run, measured on nconemap's 6.17 GB
            # archive). A per-county or per-tile archive cannot collide.
            #
            # Serializing *all* ingest to fix that was far too broad: it
            # put every county's seven ingests in one queue and took the
            # 45-county run to 2.0 min/job, about 24 hours for North
            # Carolina alone. Each of these recipes now serializes only
            # against itself, so unrelated ingests run in parallel again.
            **{
                token: int(node.recipe_id == owner)
                for owner, token in HEAP_TOKENS.items()
            },
        shell:
            f'python -m openplaces.flow.run_stage {node.stage}'
            f' {node.recipe_id}{_admin_arg}'


onsuccess:
    if config.get('email'):
        shell(
            'echo "openplaces workflow finished: {t}" | mail -s '
            '"openplaces: {t} done" {e}'.format(t=TARGET, e=config['email'])
        )


onerror:
    if config.get('email'):
        shell(
            'echo "openplaces workflow FAILED: {t}" | mail -s '
            '"openplaces: {t} FAILED" {e}'.format(t=TARGET, e=config['email'])
        )
