# Snakemake workflow for the openplaces pipeline.
#
# One job = one (stage, recipe, admin unit) node of the recipe DAG, the
# same granularity as the recipes themselves. RecipeDAG derives every
# job, its inputs/outputs, and its retention class from the recipe tree,
# so the recipes stay the single source of truth: adding an enrichment
# recipe to a curation pipeline automatically adds its jobs and its
# image-cache dependency.
#
# Retention maps onto Snakemake flags: until_consumed outputs are temp()
# (deleted only after every consuming job has finished — the
# reference-counted semantics of the lifecycle design, with zero
# openplaces bookkeeping), everything else is a plain output.
# Snakemake never writes tombstone receipts; run_stage sets
# OPENPLACES_ORCHESTRATED so receipt-based skips are voided and the
# physical files Snakemake expects are always produced.
#
# Nothing is protected(). Snakemake's protection is one-way: it strips
# write permission and then refuses to ever regenerate the file,
# aborting the run. Applied to the share bucket it meant re-curating an
# already-shipped county failed outright. The shipped bundle is guarded
# instead by io/delivery.py, which leaves its four files read-only.
# That refusal is a filesystem check, not a record of Snakemake's own
# flag, so the deliver rule clears the bit while planning (see below).
#
# The graph ends in a 'deliver' job when the target recipe declares a
# `share: delivery:` block and the run covers the region it names: every
# member county is pooled into the shareable bundle, so a full run ships
# without anyone remembering to. A narrower run gets no delivery job;
# --config deliver=true forces one, deliver=false suppresses it.
#
# An unscoped run seeds its admin units from the declared members, which
# means walking the recipe tree once per member: measured at ~7 minutes
# of graph construction for the 45-county CHEER region, before any job
# is dispatched. It is planning, not a hang.
#
# Run with --rerun-triggers mtime (set in the profile): recipe-YAML
# edits must not cascade re-runs (openplaces has no parameter hashing).
#
# Usage:
#   snakemake -n --config recipe=US_footprint-cheer-2026 \
#       admin_ids=US-NC-BS,US-NC-CE
#   snakemake -n --config recipe=US_footprint-cheer-2026   # region + ship
#   python -m openplaces.flow.submit --config recipe=... admin_ids=...

import csv
from pathlib import Path

from openplaces.flow import RecipeDAG
from openplaces.flow.dag import rule_name

TARGET = config.get('recipe', 'US_footprint-cheer-2026')
ADMIN_IDS = config.get('admin_ids', [])
if isinstance(ADMIN_IDS, str):
    ADMIN_IDS = [a for a in ADMIN_IDS.split(',') if a]

# Recipe IDs to prune from the graph (and everything only reachable through
# them), e.g. opt-in enrichment lanes not requested for this run. Not a
# fixed constant -- read from the run's own config, so lowercase.
exclude_recipe_ids = config.get('exclude_recipe_ids', [])
if isinstance(exclude_recipe_ids, str):
    exclude_recipe_ids = [r for r in exclude_recipe_ids.split(',') if r]

# None lets the DAG decide from scope; true/false override it.
deliver = config.get('deliver')
if isinstance(deliver, str):
    deliver = deliver.strip().lower() in ('1', 'true', 'yes')

dag = RecipeDAG(
    TARGET,
    admin_ids=ADMIN_IDS,
    exclude_recipe_ids=set(exclude_recipe_ids) or None,
    deliver=deliver,
)


# Per-stage resources, with single-admin pins for known heavy units and
# attempt-scaled memory on retries (see workflow/profiles/scc/mem_lookup.csv)
def _load_mem_lookup():
    lookup = {}
    lookup_path = Path(workflow.basedir) / 'profiles' / 'scc' / 'mem_lookup.csv'
    if lookup_path.exists():
        with open(lookup_path, encoding='utf-8') as f:
            for row in csv.DictReader(f):
                key = (row['stage'], row['admin_id'] or None)
                lookup[key] = int(row['mem_mb'])
    return lookup


MEM_LOOKUP = _load_mem_lookup()
STAGE_RUNTIME_MIN = {
    'ingest': 720,
    'harmonize': 240,
    'enrich': 720,
    'curate': 240,
    'deliver': 60,
}


def mem_mb(stage, admin_id):
    return MEM_LOOKUP.get((stage, admin_id), MEM_LOOKUP.get((stage, None), 8000))


rule all:
    input:
        [str(p) for p in dag.target_paths()]


for node in dag.nodes():
    _out = str(dag.output_path(node.stage, node.recipe_id, node.admin_id))
    _retention = dag.retention(node.stage, node.recipe_id, node.admin_id)
    _flagged = temp(_out) if _retention == 'until_consumed' else _out
    if node.stage == 'deliver':
        # io/delivery.py leaves the shipped bundle read-only between runs,
        # and Snakemake refuses to run any rule whose output is read-only --
        # whatever set the bit. Clear it while planning; the delivery step
        # re-locks after writing. A dry run leaves the files unlocked until
        # the next delivery, which is the price of the guard.
        from openplaces.io.delivery import unlock_delivery

        unlock_delivery(node.recipe_id)
    _job = (node.stage, node.recipe_id, node.admin_id)
    _extra = [str(p) for p in dag.extra_outputs(*_job)]
    _inputs = [str(p) for p in dag.input_paths(*_job)]
    _admin_arg = f' {node.admin_id}' if node.admin_id else ''

    rule:
        name:
            rule_name(node)
        input:
            _inputs
        output:
            _flagged,
            *_extra,
        resources:
            mem_mb=lambda wc, attempt, _s=node.stage, _a=node.admin_id: (
                mem_mb(_s, _a) * attempt
            ),
            runtime=STAGE_RUNTIME_MIN.get(node.stage, 240),
        shell:
            f'python -m openplaces.flow.run_stage {node.stage}'
            f' {node.recipe_id}{_admin_arg}'


onsuccess:
    if config.get('email'):
        shell(
            'echo "openplaces workflow finished: {t}" | mail -s '
            '"openplaces: {t} done" {e}'.format(t=TARGET, e=config['email'])
        )


onerror:
    if config.get('email'):
        shell(
            'echo "openplaces workflow FAILED: {t}" | mail -s '
            '"openplaces: {t} FAILED" {e}'.format(t=TARGET, e=config['email'])
        )
